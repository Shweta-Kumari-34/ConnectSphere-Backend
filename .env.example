# ConnectSphere backend deployment environment example

# Database
DB_USERNAME=root
DB_PASSWORD=replace_me

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# Frontend / public URLs
FRONTEND_URL=https://your-frontend-domain.vercel.app
PUBLIC_AUTH_URL=https://your-backend-domain/auth
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal service secret
CONNECTSPHERE_INTERNAL_SECRET=replace_with_an_internal_secret

# Razorpay
CONNECTSPHERE_RAZORPAY_ENABLED=false
CONNECTSPHERE_RAZORPAY_KEY_ID=
CONNECTSPHERE_RAZORPAY_KEY_SECRET=
